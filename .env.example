# Required: Server-side only. Never ship to the client.
VEXPENSES_TOKEN=your_vexpenses_api_token_here

# Required: Neon Postgres connection string (use the pooled endpoint).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional feature flag. When set to "true", the dashboard will actually
# call VExpenses write endpoints (approve/reject/reopen/pay + POST /advances).
# Starts disabled for safety — enable only after you have tested the UI.
ENABLE_WRITES=false

# Single-user login (only one person uses this dashboard).
# If APP_USER or APP_PASSWORD is missing, the app falls back to admin/admin
# and shows a warning on the login screen. Set these before exposing the app.
APP_USER=admin
APP_PASSWORD=change-me
# Long random string used to sign the session cookie. Generate with:
#   openssl rand -hex 32
APP_SESSION_SECRET=replace-with-32-byte-hex
