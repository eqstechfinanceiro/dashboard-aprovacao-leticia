# Required: Server-side only. Never ship to the client.
VEXPENSES_TOKEN=your_vexpenses_api_token_here

# Required: Neon Postgres connection string (use the pooled endpoint).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional feature flag. When set to "true", the dashboard will actually
# call VExpenses write endpoints (approve/reject/reopen/pay + POST /advances).
# Starts disabled for safety — enable only after you have tested the UI.
ENABLE_WRITES=false
