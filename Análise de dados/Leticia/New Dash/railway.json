{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd vexpenses-dashboard && npm install && npm run build",
    "watchPatterns": ["vexpenses-dashboard/**"]
  },
  "deploy": {
    "startCommand": "cd vexpenses-dashboard && npm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
