  "include": ["./sync-worker.ts", "./comprovantes-worker.ts", "../lib/sync/**/*", "../lib/comprovantes/**/*", "../lib/impacto/**/*", "../lib/db/neon.ts", "../lib/db/settings.ts", "../lib/api/laravel-token.ts", "../lib/pipeline/quinzena-dates.ts", "../lib/rules/report-filters.ts"],
  "exclude": ["../node_modules"]
}
